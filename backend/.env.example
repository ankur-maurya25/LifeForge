# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas or local)
# For MongoDB Atlas (Recommended):
# MONGO_URI=mongodb+srv://ankurmaurya3030_db_user:YOUR_ENCODED_PASSWORD@cluster0.5eodkx3.mongodb.net/lifeforge?retryWrites=true&w=majority
# For Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/lifeforge
MONGO_URI=mongodb+srv://ankurmaurya3030_db_user:YOUR_ENCODED_PASSWORD@cluster0.5eodkx3.mongodb.net/lifeforge?retryWrites=true&w=majority

# Security Configuration (Generate a fresh strong random secret)
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET

# Frontend Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://lifeforge.vercel.app

# Optional AI Life Coach Provider Integration (Safe server-side rule-based fallback active by default)
AI_COACH_API_KEY=your_ai_api_key_optional
OPENAI_API_KEY=your_openai_api_key_optional
AI_COACH_MODEL=gpt-4o-mini

